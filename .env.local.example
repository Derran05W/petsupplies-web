# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (publishable key only — secret key lives in petsupplies-api)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# petsupplies-api base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Free-shipping threshold in cents (defaults to 5000 / $50 if unset).
# Backend Phase 5 reads the same value to validate shipping at checkout.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=5000

# -----------------------------------------------------------------------------
# Phase 8 — Supabase Storage (one-time, out of code, NO env var needed)
# -----------------------------------------------------------------------------
# The admin product-image uploader writes to a Supabase Storage bucket named
# `product-images`. The bucket name is hard-coded inside
# `lib/supabase/storage.ts` (the PLAN never references it from outside the
# helper, so we don't add a new env var here).
#
# Supabase Dashboard setup (do this once per project):
#   1. Storage → Create bucket: name `product-images`, public, 5 MB file cap.
#   2. Storage → product-images → Policies → New policy:
#        INSERT / UPDATE / DELETE:
#          auth.role() = 'authenticated'
#          AND (storage.foldername(name))[1] = auth.uid()::text
#          AND (auth.jwt() -> 'app_metadata' ->> 'role') = 'ADMIN'
#        SELECT:
#          true   (public images readable by anyone)
#
# Until the bucket exists, `uploadProductImage()` falls through to a base64
# data URL so the form preview still renders in dev.
# -----------------------------------------------------------------------------
