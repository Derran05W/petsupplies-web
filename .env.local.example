# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (publishable key only — secret key lives in petsupplies-api)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# petsupplies-api base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Free-shipping threshold in cents (defaults to 5000 / $50 if unset).
# Backend Phase 5 reads the same value to validate shipping at checkout.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=5000
