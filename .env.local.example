# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (publishable key only — secret key lives in petsupplies-api)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# petsupplies-api base URL (no trailing slash).
# Local: http://localhost:3001 — browser admin uploads use Next proxy /api-backend (no CORS).
# Railway staging: set to your live Railway service URL when deployed
# NEXT_PUBLIC_* is inlined at `next dev` / `next build` start — restart after changing.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional override for next.config rewrites only:
# API_PROXY_TARGET=http://localhost:3001

# Free-shipping threshold in cents (defaults to 5000 / $50 if unset).
# Fallback only — canonical value is GET /site/settings after self-serve Phase 1.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=5000

# Shared secret for POST /api/internal/revalidate (must match petsupplies-api).
# INTERNAL_REVALIDATE_TOKEN=

# -----------------------------------------------------------------------------
# Admin product images (Phase 26 — API presigned upload)
# -----------------------------------------------------------------------------
# The admin ImageUploader does NOT upload directly from the browser to Supabase.
# Flow: POST /admin/products/images/upload-url (petsupplies-api) → PUT bytes to
# the signed URL → POST /admin/products/:id/images to attach (on edit).
#
# Web requirements:
#   - NEXT_PUBLIC_API_URL must reach a running petsupplies-api instance.
#   - Signed-in user must have admin role (JWT app_metadata.role = ADMIN).
#
# API requirements (Railway / local petsupplies-api env):
#   - SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   - SUPABASE_STORAGE_BUCKET (default: product-images)
#   - FRONTEND_URL must match the browser origin exactly (CORS), e.g.
#     http://localhost:3000 for local Next dev.
#
# Legacy note: lib/supabase/storage.ts still supports direct browser uploads with
# a base64 fallback for old dev setups; ImageUploader uses lib/api/admin/product-images.ts.
# -----------------------------------------------------------------------------
